## @file
#  GPU unlock UEFI loader - Turing backend.
#
#  SPDX-License-Identifier: GPL-2.0-only
##

[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = TuringUnlockLoader
  FILE_GUID                      = B3C91E44-6D70-4A11-9E2C-77A1B0C4D801
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING       = 0.2.14
  ENTRY_POINT                    = UefiMain

[Sources]
  Loader.c
  Log.c
  Fs.c
  Config.c
  Pci.c
  Menu.c
  Chainload.c
  Arch.c
  ../../Arch/Turing/TuringIds.c
  ../../Arch/Turing/Unlock.c
  ../../Arch/Turing/Portable/boot.c
  ../../Arch/Turing/Portable/gfw_eval.c
  ../../Arch/Turing/Portable/layout.c
  ../../Arch/Turing/Portable/prep.c
  ../../Arch/Turing/Portable/vbios.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  GpuUnlockPkg/GpuUnlockPkg.dec

[LibraryClasses]
  UefiApplicationEntryPoint
  UefiLib
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  BaseLib
  BaseMemoryLib
  MemoryAllocationLib
  PrintLib
  DebugLib
  DevicePathLib
  CacheMaintenanceLib
  PcdLib

[Protocols]
  gEfiPciIoProtocolGuid
  gEfiPciRootBridgeIoProtocolGuid
  gEfiSimpleTextInProtocolGuid
  gEfiLoadedImageProtocolGuid
  gEfiLoadedImageDevicePathProtocolGuid
  gEfiDevicePathProtocolGuid
  gEfiGraphicsOutputProtocolGuid
  gEfiSimpleTextOutProtocolGuid
  gEfiSimpleFileSystemProtocolGuid

[Guids]
  gEfiFileInfoGuid

[BuildOptions]
  MSFT:*_*_*_CC_FLAGS = /wd4201 /wd4214 /DTU_BUILD_ARCH_TURING
